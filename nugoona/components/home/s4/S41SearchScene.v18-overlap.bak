                      <span style={{ position: 'absolute', top: -8, right: -8, width: 42, height: 42, borderRadius: 999, background: '#ef4444', color: '#fff', fontSize: 26, fontWeight: 700, display: 'flex', alignItems: 'center', justifyContent: 'center', lineHeight: 1 }}>8</span>
