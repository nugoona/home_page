                  <span style={{ display: 'flex', gap: 18 }}>
                    <span style={{ width: 88, height: 88, borderRadius: 999, background: '#ffffff', boxShadow: '0 4px 14px rgba(20,20,30,0.10)', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                      <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#4a4a52" strokeWidth="2">
                        <circle cx="12" cy="12" r="3.2" />
                        <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.2 5.2l2.1 2.1M16.7 16.7l2.1 2.1M18.8 5.2l-2.1 2.1M7.3 16.7l-2.1 2.1" strokeLinecap="round" />
                      </svg>
                    </span>
                    <span style={{ position: 'relative', width: 88, height: 88, borderRadius: 999, background: '#ffffff', boxShadow: '0 4px 14px rgba(20,20,30,0.10)', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                      <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#4a4a52" strokeWidth="2">
                        <path d="M6 9a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6" strokeLinejoin="round" />
                        <path d="M10.5 20a1.7 1.7 0 0 0 3 0" strokeLinecap="round" />
