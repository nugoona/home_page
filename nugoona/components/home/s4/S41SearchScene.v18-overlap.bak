'use client';

import { motion } from 'framer-motion';

/**
 * S4-1 모바일 목업 — "앱 → 검색 발견" 겹침 장면 (사장님 확정 2026-07-14, 5차 개정)
 * 메시지: "검색할 때 우리 가게를 찾을 수 있도록"
 *
 * ▣ 5차 개정 — 앱 화면 재현 = ★실사 원본 좌표(1080px 폭 기준) 그대로 만들고 통째로 scale★
 *   (픽셀 개별 환산이 여백·라운드 비율을 계속 깨뜨림 → 실사 스샷과 동일 비율 보장 방식으로 전환).
 *   측정 원본 = 사장님 제공 실사 스샷(1080×2113) + ngn_upload 실제 소스 토큰.
 * ▣ 구도: 폰(중앙·기기 온전) 뒤 + 검색 브라우저(중앙) 앞 겹침 — 선·화살표 금지(Clone03 문법).
 *   검색 결과 = 네이버 블로그 미리보기 문법(내용·이미지는 우리 것, N 로고 등 브랜드 마크 미사용).
 * ⛔ 내 가게 글 = 결과 "중간"(순위 보장 회피, A13).
 */

/* 화면 개구부 = 캔버스 알파 스캔 실측(31.4/12.05/36.52/75.38)에서 살짝 인셋 */
const SCREEN = { left: 31.7, top: 12.35, width: 35.9, height: 74.7 };
/* ★폰 크기(6차): 비율이 맞아도 절대값이 작으면 radius·여백이 안 보임 → 폰 실폭 260px로 확대.
   프레임 렌더 폭 673 기준(폰 bbox 38.6% → 260). 화면 실폭 = 673×35.9% ≈ 241.6px. */
const FRAME_W = 673;
const PHONE_W = Math.round(FRAME_W * 0.386); // ≈ 260
const PHONE_LEFT = -Math.round(FRAME_W * 0.304); // ≈ -205
const PHONE_TOP = -Math.round(FRAME_W * 0.1105); // ≈ -74
const APP_SCALE = (FRAME_W * 0.359) / 1080; // ≈ 0.2237

const BORDER = '#ECECEC';
const LINK = '#2f6fd8';
const EASE: [number, number, number, number] = [0.16, 1, 0.3, 1];

/* 단계 마커 — Clone01 엣지 라벨 문법(흰 pill + EN 숫자). 화살표 없이 순서를 읽히는 장치. */
function StepPill({ n, label }: { n: string; label: string }) {
  return (
    <span
      className="absolute z-30 flex items-center gap-1.5 rounded-full bg-white py-[3px] pl-2 pr-2.5"
      style={{ border: `1px solid ${BORDER}`, boxShadow: '0 1px 3px rgba(0,0,0,0.06)', left: -4, top: -11 }}
    >
      <span className="text-[10px] font-semibold tracking-[0.06em] text-accent" style={{ fontFamily: 'var(--font-en)' }}>
        {n}
      </span>
      <span className="whitespace-nowrap text-[11px] font-medium tracking-[-0.01em] text-text-body">{label}</span>
    </span>
  );
}

export default function S41SearchScene() {
  return (
    <div className="mx-auto w-full max-w-[380px]" role="img" aria-label="앱이 발행한 블로그 글이 검색 결과에서 발견되는 장면">
      <div className="relative" style={{ minHeight: 872 }}>
        {/* ── 01 뒤: 앱 실물 — 기기 온전(중앙), 화면 내부 = 실사 좌표 1080 기준 × scale ── */}
        <motion.div
          initial={{ opacity: 0, y: 18 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, margin: '-60px' }}
          transition={{ duration: 0.55, ease: EASE }}
          className="absolute top-3"
          style={{ left: '50%', x: '-50%', width: PHONE_W }}
          aria-hidden
        >
          <StepPill n="01" label="사진·메모만 올리면" />
          <div className="overflow-hidden" style={{ width: PHONE_W, height: 408 }}>
          <div style={{ position: 'relative', width: FRAME_W, left: PHONE_LEFT, top: PHONE_TOP, filter: 'drop-shadow(0 18px 28px rgba(0,0,0,0.14))' }}>
            <div
              style={{
                position: 'absolute',
                left: `${SCREEN.left}%`,
                top: `${SCREEN.top}%`,
                width: `${SCREEN.width}%`,
                height: `${SCREEN.height}%`,
                overflow: 'hidden',
                borderRadius: 22,
                background: '#f4f4f7',
                zIndex: 1,
              }}
            >
              {/* ── 앱 홈 — 실사 1080px 좌표 그대로 + scale(비율 완전 동일) ── */}
              <div
                style={{
                  width: 1080,
                  transformOrigin: '0 0',
                  transform: `scale(${APP_SCALE})`,
                  fontFamily: 'var(--font-kr)',
                  padding: '150px 55px 0',
                  boxSizing: 'border-box',
                }}
              >
                {/* 헤더 */}
                <p style={{ fontSize: 30, color: '#7a7a82', margin: 0 }}>2026년 7월 14일 화요일</p>
                <p style={{ fontSize: 58, fontWeight: 800, color: '#16161a', letterSpacing: '-0.02em', margin: '8px 0 0' }}>
                  공릉파스타<span style={{ color: '#0070f3' }}>님</span>
